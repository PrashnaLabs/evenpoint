<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cfg.project }}: what to automate · Evenpoint</title>
<style>
  @font-face { font-family: "Plus Jakarta Sans"; font-weight: 200 800; font-display: swap;
    src: url(data:font/woff2;base64,{{ font }}) format("woff2"); }
  :root {
    --bg: #ffffff; --subtle: #f8fafc; --wash: #f1f5f9; --line: #e2e8f0; --line-2: #cbd5e1;
    --ink: #0f172a; --ink-2: #334155; --ink-3: #64748b;
    --blue: #2563eb; --good: #047857; --good-soft: #ecfdf5; --warn: #b45309; --warn-soft: #fffbeb;
    --quiet: #475569; --quiet-soft: #f1f5f9;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 15px/1.6 "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  main { max-width: 820px; margin: 0 auto; padding: 56px 32px 72px; }
  h1, h2, h3, p { margin: 0; }
  h1 { font-size: 28px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; }
  h2 { font-size: 16px; font-weight: 650; letter-spacing: -0.01em; margin-bottom: 14px; }
  .meta { margin-top: 8px; color: var(--ink-3); font-size: 14px; }
  .num { font-variant-numeric: tabular-nums; }
  code { font: 12.5px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ink-2); }
  section { margin-top: 44px; }

  .answer { margin-top: 32px; padding: 24px 28px; border-radius: 12px; background: var(--subtle); border: 1px solid var(--line); }
  .answer p { font-size: 22px; line-height: 1.45; letter-spacing: -0.015em; max-width: 42ch; }
  .answer strong { font-weight: 700; }
  .answer .range { margin-top: 10px; font-size: 14px; letter-spacing: 0; color: var(--ink-3); max-width: none; }

  .step { padding: 22px 0; border-top: 1px solid var(--line); break-inside: avoid; }
  .step:last-child { border-bottom: 1px solid var(--line); }
  .step-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .step-head h3 { font-size: 17px; font-weight: 650; letter-spacing: -0.01em; }
  .step-grid { display: grid; grid-template-columns: minmax(0, 1fr) 190px; gap: 8px 32px; align-items: end; margin-top: 8px; }
  .why { color: var(--ink-2); font-size: 14px; }
  .why .soft { color: var(--ink-3); }
  .figures { text-align: right; }
  .figures strong { display: block; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
  .figures span { display: block; color: var(--ink-3); font-size: 13px; }

  .badge { display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 999px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
  .badge.automate { background: var(--good-soft); color: var(--good); }
  .badge.review { background: var(--warn-soft); color: var(--warn); }
  .badge.dont_automate, .badge.untested { background: var(--quiet-soft); color: var(--quiet); }

  /* Range bar ("bullet"): band = plausible range, dot = likely value, line = zero. Every value is also in text. */
  .bar { position: relative; height: 8px; margin: 16px 0 6px; border-radius: 999px; background: var(--wash); }
  .bar .zero { position: absolute; top: -5px; bottom: -5px; width: 1px; background: var(--line-2); }
  .bar .band { position: absolute; top: 0; bottom: 0; border-radius: 999px; }
  .bar .dot { position: absolute; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; box-shadow: 0 0 0 2px #fff; }
  .automate .band { background: #a7f3d0; } .automate .dot { background: var(--good); }
  .review .band { background: #fde68a; } .review .dot { background: var(--warn); }
  .dont_automate .band { background: #e2e8f0; } .dont_automate .dot { background: var(--quiet); }
  .bar-text { display: flex; justify-content: space-between; color: var(--ink-3); font-size: 12.5px; }

  .untested-list { list-style: none; margin: 0; padding: 0; }
  .untested-list li { padding: 14px 0; border-top: 1px solid var(--line); break-inside: avoid; }
  .untested-list li:last-child { border-bottom: 1px solid var(--line); }
  .untested-list p { color: var(--ink-3); font-size: 14px; margin-top: 4px; }

  .prose { color: var(--ink-2); max-width: 68ch; }
  .prose + .prose { margin-top: 10px; }
  .kv { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 24px; margin-top: 16px; max-width: 560px; font-size: 14px; }
  .kv dt { color: var(--ink-2); } .kv dd { margin: 0; text-align: right; font-weight: 600; }
  .note { margin-top: 14px; padding: 12px 14px; border-radius: 8px; background: var(--warn-soft); color: #78350f; font-size: 14px; }

  .appendix { margin-top: 56px; padding-top: 28px; border-top: 2px solid var(--ink); break-before: page; }
  .appendix h2 { font-size: 15px; }
  .appendix section { margin-top: 28px; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; }
  th { text-align: left; font-size: 12px; font-weight: 600; color: var(--ink-3); padding: 8px 10px; border-bottom: 1px solid var(--line-2); }
  td { padding: 9px 10px; border-bottom: 1px solid var(--line); }
  .r { text-align: right; }
  footer { margin-top: 48px; color: var(--ink-3); font-size: 12.5px; }

  @page { size: A4; margin: 16mm 14mm; }
  @media print {
    main { padding: 0; max-width: none; }
    .answer { break-inside: avoid; }
    section h2 { break-after: avoid; }
  }
  @media (max-width: 640px) {
    main { padding: 32px 18px 48px; }
    h1 { font-size: 24px; }
    .answer { padding: 20px; }
    .answer p { font-size: 19px; }
    .step-grid { grid-template-columns: 1fr; }
    .figures { text-align: left; }
  }
</style>
</head>
<body>
<main>
  <header>
    <h1>{{ cfg.project }}: what to automate</h1>
    <p class="meta">Prepared {{ generated.strftime("%-d %B %Y") }} from {{ quality.cases | num }} cases{% if quality.first_ts %}, {{ quality.first_ts.strftime("%-d %b %Y") }} to {{ quality.last_ts.strftime("%-d %b %Y") }}{% endif %}</p>
  </header>

  <div class="answer">
    {% if worth %}
      <p>Automating <strong>{{ worth | length }} of {{ best | length }}</strong> tested {{ "step" if best | length == 1 else "steps" }} would save about <strong>{{ totals.net_hours_month | hrs }} a month</strong>, worth <strong>{{ totals.net_value_month | usd }}</strong>.</p>
      <p class="range num">Likely between {{ totals.net_value_low | usd }} and {{ totals.value_high | usd }} a month, based on how often the AI was right on {{ n_cases.values() | sum | num }} real past cases.</p>
    {% elif best %}
      <p>Nothing is worth automating yet: none of the {{ best | length }} tested steps saves more than it costs.</p>
      <p class="range">That's a useful answer too. See below for how close each step came.</p>
    {% else %}
      <p>No step could be tested yet.</p>
    {% endif %}
  </div>

  {% if best %}
  <section>
    <h2>Step by step</h2>
    {% for r in best %}
    <div class="step {{ r.verdict }}">
      <div class="step-head">
        <h3>{{ r.activity | step }}</h3>
        <span class="badge {{ r.verdict }}">{{ {"automate": "Automate", "review": "Automate with review", "dont_automate": "Don't automate"}[r.verdict] }}</span>
      </div>
      <div class="step-grid">
        <div>
          <p class="why"><code>{{ r.model | model }}</code> was right on {{ r.accuracy | pct }} of {{ n_cases.get((r.activity, r.model), "–") }} past cases{% if r.mode == "draft_review" %}, with a person approving each answer{% endif %}.
            <span class="soft">{{ r.reason }}</span></p>
          <div class="bar" role="img" aria-label="Likely {{ r.net_hours_month | hrs }} a month, between {{ r.net_hours_low | hrs }} and {{ r.net_hours_high | hrs }}">
            <span class="zero" style="left: {{ r.bar.zero }}%"></span>
            <span class="band" style="left: {{ r.bar.left }}%; width: {{ r.bar.width }}%"></span>
            <span class="dot" style="left: {{ r.bar.point }}%"></span>
          </div>
          <div class="bar-text num"><span>Low {{ r.net_hours_low | hrs }}</span><span>Likely {{ r.net_hours_month | hrs }}</span><span>High {{ r.net_hours_high | hrs }}</span></div>
        </div>
        <div class="figures num">
          <strong>{{ r.net_value_month | usd }} / mo</strong>
          <span>{{ r.net_value_low | usd }} to {{ r.value_high | usd }}</span>
          <span>{% if r.net_hours_month >= 0 %}{{ r.net_hours_month | hrs }} saved a month{% else %}{{ (-r.net_hours_month) | hrs }} lost a month{% endif %}{% if r.payback_months is not none %} · pays back in {{ r.payback_months | num(1) }} mo{% endif %}</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if untested %}
  <section>
    <h2>Not tested</h2>
    <ul class="untested-list">
      {% for d in untested %}<li><strong>{{ d.activity | step }}</strong> <span class="badge untested">Not tested</span><p>{{ d.reason }}</p></li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <section>
    <h2>How this was measured</h2>
    <p class="prose">Evenpoint read {{ quality.cases | num }} cases from the team's own export and measured how often each step happens. It then gave real past cases to AI models and compared every answer with what the team actually did. The share of correct answers, the team's time and the assumptions below give the hours and money. Ranges come from the size of the test sample: more test cases make them narrower.</p>
    <dl class="kv num">
      <dt>Hourly cost of a team member</dt><dd>{{ cfg.hourly_rate | usd }}</dd>
      <dt>Minutes to check one AI answer</dt><dd>{{ cfg.review_minutes.draft_review | num(1) }}</dd>
      <dt>Extra minutes when a wrong answer reaches a customer</dt><dd>{{ cfg.failure_minutes | num(1) }}</dd>
      <dt>One-off setup cost</dt><dd>{{ cfg.setup_cost_usd | usd }}</dd>
      <dt>Past cases tested per step</dt><dd>{{ cfg.bench.tasks_per_candidate | num }}</dd>
    </dl>
    {% for w in quality.warnings %}<p class="note">{{ w }}</p>{% endfor %}
    {% if unpriced %}<p class="note">No price is known for {{ unpriced | map("model") | join(", ") }}, so its cost counts as $0.</p>{% endif %}
  </section>

  <div class="appendix">
    <h2>Appendix</h2>

    <section>
      <h2>How each model did</h2>
      <table>
        <thead><tr><th>Step</th><th>Model</th><th class="r">Right</th><th class="r">Test cases</th><th class="r">Cost per case</th></tr></thead>
        <tbody>
          {% for s in summaries %}
          <tr><td>{{ s.activity | step }}</td><td><code>{{ s.model | model }}</code></td><td class="r">{{ s.accuracy | pct }}</td><td class="r">{{ s.n }}</td>
            <td class="r">{{ "$%.4f" | format(s.cost_per_task) if s.cost_per_task < 0.01 else s.cost_per_task | usd(3) }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <h2>How the work flows today</h2>
      <table>
        <thead><tr><th>Step</th><th class="r">Per month</th><th class="r">Minutes each</th><th class="r">Hours a month</th></tr></thead>
        <tbody>
          {% for s in steps %}
          <tr><td>{{ s.activity | step }}</td><td class="r">{{ s.volume_per_month | num }}</td>
            <td class="r">{{ s.median_minutes | num(1) }}{% if s.minutes_source == "config" %} <span style="color:var(--ink-3)">(estimate)</span>{% endif %}</td>
            <td class="r">{{ s.baseline_hours_month | num(1) }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Data and privacy</h2>
      <p class="prose">Emails, phone numbers, card numbers and staff names were removed before any text was sent to {{ providers | map("provider") | join(", ") or "a model" }}. Customer names written in free text can slip through. {{ calls | sum(attribute="n") | num }} model calls were made for this analysis, costing {{ total_cost | usd(2) }} in total. Every prompt and answer is kept with the project for audit.</p>
    </section>
  </div>

  <footer>Made with Evenpoint {{ version }}. Measured on this team's own data.</footer>
</main>
</body>
</html>
