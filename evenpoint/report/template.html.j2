<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cfg.project }}: what to automate · Evenpoint</title>
<style>
  @font-face { font-family: "Plus Jakarta Sans"; font-weight: 200 800; font-display: swap;
    src: url(data:font/woff2;base64,{{ font }}) format("woff2"); }
  :root {
    --bg: #f8fafc; --card: #ffffff; --wash: #f1f5f9; --line: #e2e8f0; --line-2: #cbd5e1;
    --ink: #0f172a; --ink-2: #334155; --ink-3: #64748b;
    --blue: #2563eb; --blue-2: #93c5fd;
    --good: #047857; --good-soft: #ecfdf5; --good-band: #a7f3d0;
    --warn: #b45309; --warn-soft: #fffbeb; --warn-band: #fde68a;
    --quiet: #475569; --quiet-soft: #f1f5f9; --quiet-band: #e2e8f0;
    color-scheme: light;
  }
  * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 15px/1.6 "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  main { max-width: 860px; margin: 0 auto; padding: 32px 28px 64px; }
  h1, h2, h3, p { margin: 0; }
  .num { font-variant-numeric: tabular-nums; }
  code { font: 13px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ink-2); }

  /* Header */
  .brandbar { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -0.02em; }
  .brand-mark { width: 26px; height: 26px; border-radius: 8px; background: var(--ink); display: grid; place-items: center; }
  .brandbar .doc { color: var(--ink-3); font-size: 13px; }
  .title { margin-top: 32px; }
  .title h1 { font-size: 32px; font-weight: 750; letter-spacing: -0.03em; line-height: 1.15; }
  .title p { margin-top: 8px; color: var(--ink-3); font-size: 14px; }

  /* Hero: the answer */
  .hero { margin-top: 28px; padding: 32px; border-radius: 20px; background: radial-gradient(120% 140% at 100% 0%, #1e3a8a 0%, var(--ink) 55%); color: #fff; break-inside: avoid; }
  .hero-label { color: #93c5fd; font-size: 13px; font-weight: 600; margin-bottom: 8px; }
  .hero-figure { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .hero-figure strong { font-size: 52px; font-weight: 750; letter-spacing: -0.04em; line-height: 1; }
  .hero-figure span { color: #cbd5e1; font-size: 16px; }
  .hero-text { margin-top: 14px; font-size: 18px; line-height: 1.5; color: #e2e8f0; max-width: 48ch; }
  .hero-text b { color: #fff; font-weight: 650; }
  .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }
  .stat { padding: 14px 16px; border-radius: 12px; background: rgb(255 255 255 / 0.08); }
  .stat dt { color: #94a3b8; font-size: 13px; }
  .stat dd { margin: 4px 0 0; font-size: 19px; font-weight: 650; letter-spacing: -0.01em; }
  .hero.none { background: var(--ink); }

  /* Sections */
  section { margin-top: 40px; }
  .section-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .section-title h2 { font-size: 19px; font-weight: 700; letter-spacing: -0.02em; }
  .section-title span { color: var(--ink-3); font-size: 13px; }

  /* Step cards */
  .steps { display: grid; gap: 12px; }
  .step { padding: 22px 24px; border-radius: 16px; background: var(--card); border: 1px solid var(--line); break-inside: avoid; }
  .step-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .step-head h3 { font-size: 17px; font-weight: 700; letter-spacing: -0.015em; }
  .step-grid { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 8px 32px; align-items: end; margin-top: 10px; }
  .why { color: var(--ink-2); font-size: 14px; }
  .why .soft { color: var(--ink-3); }
  .figures { text-align: right; }
  .figures strong { display: block; font-size: 24px; font-weight: 750; letter-spacing: -0.025em; }
  .figures span { display: block; color: var(--ink-3); font-size: 13px; }
  .badge { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 11px; border-radius: 999px; font-size: 13px; font-weight: 650; white-space: nowrap; }
  .badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .badge.automate { background: var(--good-soft); color: var(--good); }
  .badge.review { background: var(--warn-soft); color: var(--warn); }
  .badge.dont_automate, .badge.untested { background: var(--quiet-soft); color: var(--quiet); }

  /* Range bar: band = plausible range, dot = likely value, line = zero; every value is also written out. */
  .bar { position: relative; height: 10px; margin: 18px 0 8px; border-radius: 999px; background: var(--wash); }
  .bar .zero { position: absolute; top: -5px; bottom: -5px; width: 2px; margin-left: -1px; border-radius: 2px; background: var(--line-2); }
  .bar .band { position: absolute; top: 0; bottom: 0; border-radius: 999px; }
  .bar .dot { position: absolute; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 1px 3px rgb(15 23 42 / 0.25); }
  .automate .band { background: var(--good-band); } .automate .dot { background: var(--good); }
  .review .band { background: var(--warn-band); } .review .dot { background: var(--warn); }
  .dont_automate .band { background: var(--quiet-band); } .dont_automate .dot { background: var(--quiet); }
  .bar-text { display: flex; justify-content: space-between; color: var(--ink-3); font-size: 13px; }
  .bar-text b { color: var(--ink); font-weight: 650; }

  .untested { display: grid; gap: 10px; }
  .untested .step { padding: 16px 20px; }
  .untested p { color: var(--ink-3); font-size: 14px; margin-top: 6px; }

  /* Method */
  .method { padding: 24px; border-radius: 16px; background: var(--card); border: 1px solid var(--line); break-inside: avoid; }
  .prose { color: var(--ink-2); max-width: 70ch; }
  .assume { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 18px; }
  .assume div { padding: 12px 14px; border-radius: 12px; background: var(--wash); }
  .assume dt { color: var(--ink-3); font-size: 13px; line-height: 1.35; }
  .assume dd { margin: 6px 0 0; font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
  .note { margin-top: 14px; padding: 12px 14px; border-radius: 12px; background: var(--warn-soft); color: #78350f; font-size: 14px; }

  /* Appendix */
  .appendix { margin-top: 48px; break-before: page; }
  .appendix > h2 { font-size: 13px; font-weight: 650; color: var(--ink-3); padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .appendix section { margin-top: 24px; }
  .appendix h3 { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 10px; }
  .table { border-radius: 14px; border: 1px solid var(--line); background: var(--card); overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  th { text-align: left; font-size: 13px; font-weight: 600; color: var(--ink-3); padding: 10px 16px; background: var(--wash); }
  td { padding: 11px 16px; border-top: 1px solid var(--line); }
  .r { text-align: right; }
  .soft { color: var(--ink-3); }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--ink-3); font-size: 13px; }

  @page { size: A4; margin: 14mm 12mm; }
  @media print { body { background: #fff; } main { padding: 0; max-width: none; } .section-title { break-after: avoid; } }
  @media (max-width: 640px) {
    main { padding: 24px 16px 48px; }
    .title h1 { font-size: 26px; }
    .hero { padding: 24px; border-radius: 16px; }
    .hero-figure strong { font-size: 40px; }
    .hero-stats { gap: 8px; }
    .stat { padding: 10px 12px; }
    .stat dt { font-size: 13px; line-height: 1.3; }
    .stat dd { font-size: 16px; }
    .step-grid { grid-template-columns: 1fr; }
    .figures { text-align: left; }
  }
</style>
</head>
<body>
<main>
  <div class="brandbar">
    <span class="brand">
      <span class="brand-mark" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 32 32"><path d="M5 18h22" stroke="#fff" stroke-width="3" stroke-linecap="round"/><path d="M16 18l-5 8h10z" fill="#93b4fb"/><circle cx="9.5" cy="12" r="3.4" fill="#fff"/><circle cx="22.5" cy="12" r="3.4" fill="#fff"/></svg></span>
      Evenpoint
    </span>
    <span class="doc">AI automation report · {{ generated.strftime("%-d %B %Y") }}</span>
  </div>

  <header class="title">
    <h1>{{ cfg.project }}: what to automate</h1>
    <p>{{ quality.cases | num }} cases{% if quality.first_ts %} from {{ quality.first_ts.strftime("%-d %b %Y") }} to {{ quality.last_ts.strftime("%-d %b %Y") }}{% endif %}, tested on {{ n_cases.values() | max | num }} real past cases per step</p>
  </header>

  {% if worth %}
  <div class="hero">
    <p class="hero-label">Estimated savings</p>
    <div class="hero-figure num"><strong>{{ totals.net_value_month | usd }}</strong><span>a month · real savings could be anywhere from {{ totals.net_value_low | usd }} to {{ totals.value_high | usd }}</span></div>
    <p class="hero-text">Automating <b>{{ worth | length }} of {{ best | length }}</b> tested {{ "step" if best | length == 1 else "steps" }} would save about <b>{{ totals.net_hours_month | hrs }} of the team's time a month</b>.</p>
    <dl class="hero-stats num">
      <div class="stat"><dt>Steps worth automating</dt><dd>{{ worth | length }} of {{ best | length }}</dd></div>
      <div class="stat"><dt>Test cases per step</dt><dd>{{ n_cases.values() | max | num }}</dd></div>
      <div class="stat"><dt>Cost of this analysis</dt><dd>{{ total_cost | usd(2) }}</dd></div>
    </dl>
  </div>
  {% else %}
  <div class="hero none">
    <p class="hero-text" style="margin:0;font-size:22px;color:#fff">{% if best %}Nothing is worth automating yet: none of the {{ best | length }} tested steps saves more than it costs.{% else %}No step could be tested yet.{% endif %}</p>
    {% if best %}<p class="hero-text">That's a useful answer too. Below is how close each step came.</p>{% endif %}
  </div>
  {% endif %}

  {% if best %}
  <section>
    <div class="section-title"><h2>Step by step</h2><span>Best option found for each step</span></div>
    <div class="steps">
      {% for r in best %}
      <div class="step {{ r.verdict }}">
        <div class="step-head">
          <h3>{{ r.activity | step }}</h3>
          <span class="badge {{ r.verdict }}">{{ {"automate": "Automate", "review": "Automate with review", "dont_automate": "Don't automate"}[r.verdict] }}</span>
        </div>
        <div class="step-grid">
          <div>
            <p class="why"><code>{{ r.model | model }}</code> was right on {{ r.accuracy | pct }} of {{ n_cases.get((r.activity, r.model), "–") }} past cases{% if r.mode == "draft_review" %}, with a person approving each answer{% endif %}.
              <span class="soft">{{ r.reason }}</span></p>
            <div class="bar" role="img" aria-label="Likely {{ r.net_hours_month | hrs }} a month, between {{ r.net_hours_low | hrs }} and {{ r.net_hours_high | hrs }}">
              <span class="zero" style="left: {{ r.bar.zero }}%"></span>
              <span class="band" style="left: {{ r.bar.left }}%; width: {{ r.bar.width }}%"></span>
              <span class="dot" style="left: {{ r.bar.point }}%"></span>
            </div>
            <div class="bar-text num"><span>Low {{ r.net_hours_low | hrs }}</span><span>Estimate <b>{{ r.net_hours_month | hrs }}</b></span><span>High {{ r.net_hours_high | hrs }}</span></div>
          </div>
          <div class="figures num">
            <strong>{{ r.net_value_month | usd }}<span style="display:inline;font-size:14px;font-weight:500"> / mo</span></strong>
            <span>savings could be {{ r.net_value_low | usd }} to {{ r.value_high | usd }}</span>
            <span>{% if r.net_hours_month >= 0 %}{{ r.net_hours_month | hrs }} saved a month{% else %}{{ (-r.net_hours_month) | hrs }} lost a month{% endif %}{% if r.payback_months is not none %} · pays back in {{ r.payback_months | num(1) }} mo{% endif %}</span>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if untested %}
  <section>
    <div class="section-title"><h2>Not tested</h2><span>Left alone on purpose</span></div>
    <div class="untested">
      {% for d in untested %}<div class="step"><div class="step-head"><h3>{{ d.activity | step }}</h3><span class="badge untested">Not tested</span></div><p>{{ d.reason }}</p></div>{% endfor %}
    </div>
  </section>
  {% endif %}

  <section>
    <div class="section-title"><h2>How this was measured</h2></div>
    <div class="method">
      <p class="prose">Evenpoint read {{ quality.cases | num }} cases from the team's own export and measured how often each step happens. It then gave real past cases to AI models and compared every answer with what the team actually did. The share of correct answers, the team's time and the assumptions below give the hours and money. Each "could be" range shows how far the savings could move because the AI was tested on a sample of cases rather than all of them; the hourly cost and minutes below are taken as given. More test cases make the ranges narrower.</p>
      <dl class="assume num">
        <div><dt>Hourly cost of a team member</dt><dd>{{ cfg.hourly_rate | usd }}</dd></div>
        <div><dt>Minutes to check one AI answer</dt><dd>{{ cfg.review_minutes.draft_review | num(1) }}</dd></div>
        <div><dt>Extra minutes when a wrong answer reaches a customer</dt><dd>{{ cfg.failure_minutes | num(1) }}</dd></div>
        <div><dt>One-off setup cost</dt><dd>{{ cfg.setup_cost_usd | usd }}</dd></div>
      </dl>
      {% for w in quality.warnings %}<p class="note">{{ w }}</p>{% endfor %}
      {% if unpriced %}<p class="note">No price is known for {{ unpriced | map("model") | join(", ") }}, so its cost counts as $0.</p>{% endif %}
    </div>
  </section>

  <div class="appendix">
    <h2>Appendix</h2>

    <section>
      <h3>How each model did</h3>
      <div class="table"><table>
        <thead><tr><th>Step</th><th>Model</th><th class="r">Right</th><th class="r">Test cases</th><th class="r">Cost per case</th></tr></thead>
        <tbody>
          {% for s in summaries %}
          <tr><td>{{ s.activity | step }}</td><td><code>{{ s.model | model }}</code></td><td class="r">{{ s.accuracy | pct }}</td><td class="r">{{ s.n }}</td>
            <td class="r">{{ "$%.4f" | format(s.cost_per_task) if s.cost_per_task < 0.01 else s.cost_per_task | usd(3) }}</td></tr>
          {% endfor %}
        </tbody>
      </table></div>
    </section>

    <section>
      <h3>How the work flows today</h3>
      <div class="table"><table>
        <thead><tr><th>Step</th><th class="r">Per month</th><th class="r">Minutes each</th><th class="r">Hours a month</th></tr></thead>
        <tbody>
          {% for s in steps %}
          <tr><td>{{ s.activity | step }}</td><td class="r">{{ s.volume_per_month | num }}</td>
            <td class="r">{{ s.median_minutes | num(1) }}{% if s.minutes_source == "config" %} <span class="soft">estimate</span>{% endif %}</td>
            <td class="r">{{ s.baseline_hours_month | num(1) }}</td></tr>
          {% endfor %}
        </tbody>
      </table></div>
    </section>

    <section>
      <h3>Data and privacy</h3>
      <p class="prose">Emails, phone numbers, card numbers and staff names were removed before any text was sent to {{ providers | map("provider") | join(", ") or "a model" }}. Customer names written in free text can slip through. {{ calls | sum(attribute="n") | num }} model calls were made for this analysis, costing {{ total_cost | usd(2) }} in total. Every prompt and answer is kept with the project for audit.</p>
    </section>
  </div>

  <footer><span>Made with Evenpoint {{ version }}</span><span>Measured on this team's own data</span></footer>
</main>
</body>
</html>
