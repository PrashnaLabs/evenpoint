---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Projects" active="projects">
  <div class="page-head"><h1>Projects</h1></div>

  <div id="key-panel"></div>
  <div id="projects"></div>
</Shell>

<style>
  :global(.cards) { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  :global(.card) { display: grid; gap: 20px; align-content: space-between; min-height: 168px; padding: 24px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); text-decoration: none; transition: border-color 180ms, transform 180ms var(--ease), box-shadow 180ms; }
  :global(.card:hover) { border-color: var(--border-strong); color: var(--text); transform: translateY(-2px); box-shadow: var(--shadow-2); }
  :global(.card-name) { font-size: 16px; font-weight: 650; letter-spacing: -0.015em; }
  :global(.card-meta) { margin-top: 4px; color: var(--text-3); font-size: 13px; }
  :global(.card-answer) { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  :global(.card-answer strong) { font-size: 24px; font-weight: 700; letter-spacing: -0.03em; }
  :global(.card-answer span) { color: var(--text-3); font-size: 14px; }
  :global(.card-answer.none) { color: var(--text-3); font-size: 14px; }
  :global(.examples) { margin-top: 48px; }
  :global(.examples h2) { font-size: 14px; color: var(--text-3); font-weight: 600; margin-bottom: 12px; }
  :global(.example-list) { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
  :global(.example) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 16px 18px; border: 1px dashed var(--border-strong); border-radius: var(--radius); background: transparent; font: inherit; color: var(--text-3); text-align: left; transition: border-color 180ms, background 180ms; }
  :global(.example:hover) { border-color: var(--accent); background: var(--accent-soft); }
  :global(.example[aria-busy="true"]) { opacity: 0.6; pointer-events: none; }
  :global(.example > span:first-child) { display: grid; gap: 2px; }
  :global(.example strong) { color: var(--text); font-weight: 600; }
  #key-panel:not(:empty) { margin-bottom: 24px; }
</style>

<script>
  import { api, ApiError, type ProjectSummary, type Status } from "../lib/api";
  import { $, ago, busy, hrs, html, icon, mount, num, toast, usd } from "../lib/ui";


  function keyPanel(status: Status) {
    const host = $("#key-panel")!;
    const wanted = !status.openai_key || new URLSearchParams(location.search).has("settings");
    if (!wanted) return mount(host, "");
    mount(host, html`
      <form class="panel" id="key-form">
        <div class="settings-row">
          <header>
            <h2>OpenAI API key</h2>
            <p>Evenpoint calls OpenAI with your own key to test models on your data. It's saved to <code>.env</code> in your projects folder and never leaves this computer.</p>
          </header>
          <div class="stack">
            ${status.openai_key ? html`<div class="callout success">${icon("CircleCheck")}<span>A key is connected. Paste a new one to replace it.</span></div>` : ""}
            <div class="field">
              <label for="key-input">API key</label>
              <input class="input mono" id="key-input" type="password" placeholder="sk-…" autocomplete="off" spellcheck="false" required />
              <span class="hint">Create one at platform.openai.com → API keys.</span>
            </div>
            <div><button class="btn primary" type="submit" id="key-save">${icon("KeyRound")}Save key</button></div>
          </div>
        </div>
      </form>`);
    $("#key-form")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = $<HTMLButtonElement>("#key-save");
      busy(btn, true, "Saving");
      try {
        await api("/settings/key", { method: "POST", body: { openai_api_key: $<HTMLInputElement>("#key-input")!.value } });
        toast("OpenAI key saved.");
        history.replaceState(null, "", "/");
        location.reload();
      } catch (err) {
        toast((err as Error).message, "error");
        busy(btn, false);
      }
    });
  }

  function emptyState(status: Status) {
    return html`
      <div class="panel">
        <div class="empty">
          <div class="empty-icon">${icon("FileSpreadsheet", "lg")}</div>
          <h2>Start with an export of your team's work</h2>
          <p>A Zendesk or Jira CSV, any spreadsheet saved as CSV, or an email export. Evenpoint finds the steps your team repeats and tests AI models on real past cases.</p>
          <div class="row">
            <a class="btn primary" href="/start/">${icon("Plus")}New analysis</a>
          </div>
          ${examples(status, [], "Or explore a ready-made example")}
        </div>
      </div>`;
  }

  function examples(status: Status, projects: ProjectSummary[], title: string) {
    const have = new Set(projects.map((p) => p.name));
    const list = status.examples.filter((x) => !have.has(`example-${x.id}`));
    if (!list.length) return html``;
    return html`
      <section class="examples">
        <h2>${title}</h2>
        <div class="example-list">
          ${list.map((x) => html`
            <button class="example" type="button" data-example="${x.id}">
              <span><strong>${x.title}</strong><span class="hint">${x.about}</span></span>
              ${icon("ArrowRight")}
            </button>`)}
        </div>
      </section>`;
  }

  /** One card per project, leading with its answer. */
  function cards(projects: ProjectSummary[]) {
    return html`
      <div class="cards">
        ${projects.map((p) => {
          const r = p.run;
          const answer = !r
            ? html`<p class="card-answer none">Not run yet · <span style="color:var(--accent);font-weight:600">Continue ${icon("ArrowRight", "sm")}</span></p>`
            : r.worth_automating
              ? html`<p class="card-answer num"><strong>${hrs(r.hours)}</strong><span>saved a month · ${usd(r.value)}</span></p>`
              : html`<p class="card-answer none">Nothing worth automating yet</p>`;
          const href = r ? `/project/?p=${encodeURIComponent(p.name)}` : `/start/?p=${encodeURIComponent(p.name)}&step=1`;
          return html`
            <a class="card" href="${href}">
              <div>
                <div class="card-name">${p.name}</div>
                <div class="card-meta">${p.sources[0] || "No data yet"}${r ? ` · ${num(r.cases)} cases · ${ago(r.started_at)}` : ""}</div>
              </div>
              ${answer}
            </a>`;
        })}
      </div>`;
  }

  function skeleton() {
    return html`<div class="cards">${[1, 2].map(() => html`<div class="skeleton" style="height:168px;border-radius:12px"></div>`)}</div>`;
  }

  async function load() {
    const host = $("#projects")!;
    mount(host, skeleton());
    try {
      const [status, projects] = await Promise.all([api<Status>("/status"), api<ProjectSummary[]>("/projects")]);
      keyPanel(status);
      const deleted = new URLSearchParams(location.search).get("deleted");
      if (deleted) {
        toast(`Deleted ${deleted}.`);
        history.replaceState(null, "", "/");
      }
      if (!projects.length && !new URLSearchParams(location.search).has("settings")) {
        location.replace("/start/");  // first visit: straight into the guided start
        return;
      }
      mount(host, projects.length
        ? html`${cards(projects)}${examples(status, projects, "Explore an example")}`
        : emptyState(status));
      host.querySelectorAll<HTMLButtonElement>("[data-example]").forEach((btn) => btn.addEventListener("click", async () => {
        btn.setAttribute("aria-busy", "true");
        try {
          const p = await api<ProjectSummary>("/projects/sample", { method: "POST", body: { example: btn.dataset.example } });
          location.href = `/project/?p=${encodeURIComponent(p.name)}&tab=setup`;
        } catch (err) {
          toast((err as Error).message, "error");
          btn.removeAttribute("aria-busy");
        }
      }));
    } catch (err) {
      const msg = err instanceof ApiError && err.status ? err.message : "Couldn't reach Evenpoint. Start it with `evenpoint ui`.";
      mount(host, html`<div class="callout error">${icon("TriangleAlert")}<span>${msg}</span></div>`);
    }
  }
  load();
</script>
