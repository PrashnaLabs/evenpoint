---
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { Plus } from "lucide-static";

interface Props { title: string; active?: "projects" | "start" }
const { title, active } = Astro.props;
const svg = (s: string) => s.replace(/\s(width|height)="24"/g, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Evenpoint</title>
  </head>
  <body>
    <!--
      THESIS: A modern, minimal tool that gets an ops lead from an export to a defensible answer in minutes. Only what helps the decision is on screen; evidence waits one click away.
      OWN-WORLD: Minimalism & Swiss (ui-ux-pro-max). Slate neutrals (#f8fafc ground, white cards, #e2e8f0 hairlines), one blue (#2563eb), verdict colours only for meaning. Plus Jakarta Sans; Geist Mono for ids and model names. 12px cards, pill tabs, no decorative shadows. Lucide line icons.
      STORY: Drop a file, confirm what was found, run; read the answer and one row per step; check a few AI answers.
      FIRST VIEWPORT: Slim top bar (brand, Projects, key status, New analysis). Page: big title left, one primary action right; then the answer sentence and step rows, or project cards.
      FORM: user-directed redesign with the ui-ux-pro-max design system (Minimalism & Swiss, light, low variance, subtle motion).
    -->
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 32 32"><path d="M5 18h22" stroke="#fff" stroke-width="3" stroke-linecap="round"/><path d="M16 18l-5 8h10z" fill="#93b4fb"/><circle cx="9.5" cy="12" r="3.4" fill="#fff"/><circle cx="22.5" cy="12" r="3.4" fill="#fff"/></svg>
        </span>
        Evenpoint
      </a>
      <nav class="topnav" aria-label="Main">
        <a href="/" aria-current={active === "projects" ? "page" : undefined}>Projects</a>
      </nav>
      <div class="topbar-end">
        <a class="key-status" href="/?settings=1" id="key-status" title="OpenAI key">
          <span class="dot"></span><span>Checking key…</span>
        </a>
        <a class="btn primary sm" href="/start/"><span class="ico" set:html={svg(Plus)} />New analysis</a>
      </div>
    </header>
    <main class="page" id="page">
      <slot />
    </main>
    <script>
      import { api, type Status } from "../lib/api";
      import { html, mount, $ } from "../lib/ui";

      /** `evenpoint ui --reload`: refresh when the server restarts or the UI is rebuilt (skipped while a form is unsaved). */
      async function watchForChanges() {
        let first: string | null = null;
        for (;;) {
          await new Promise((r) => setTimeout(r, 1000));
          try {
            const { stamp } = await api<{ stamp: string }>("/dev/stamp");
            if (first === null) first = stamp;
            else if (stamp !== first && !document.querySelector("[data-dirty='true']")) location.reload();
          } catch { /* server restarting */ }
        }
      }
      api<Status>("/status").then((s) => {
        const el = $("#key-status");
        if (el) mount(el, s.openai_key
          ? html`<span class="dot on"></span><span>Key connected</span>`
          : html`<span class="dot off"></span><span>Add OpenAI key</span>`);
        if (s.dev) watchForChanges();
      }).catch(() => {
        const el = $("#key-status");
        if (el) mount(el, html`<span class="dot"></span><span>Server not reachable</span>`);
      });
    </script>
  </body>
</html>
